{
  "manifest_version": 3,
  "name": "Alerter — Phishing & Spam Protection",
  "version": "1.1.3",
  "description": "Automatically checks websites and email for phishing, warns on risky destinations, and blocks common ad requests.",
  "permissions": ["activeTab", "notifications", "declarativeNetRequest"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "basic_ads", "enabled": true, "path": "rules/ads.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Alerter — scan this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/alerter-16.png",
      "48": "icons/alerter-48.png",
      "128": "icons/alerter-128.png"
    }
  },
  "icons": {
    "16": "icons/alerter-16.png",
    "48": "icons/alerter-48.png",
    "128": "icons/alerter-128.png"
  }
}
