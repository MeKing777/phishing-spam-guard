{
  "manifest_version": 3,
  "name": "Alerter — Phishing & Spam Protection",
  "version": "1.1.1",
  "description": "Checks web links, email messages, and user-requested visible screen text with local phishing and spam analysis.",
  "permissions": ["activeTab", "notifications"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "alerter-security@example.org",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Alerter — scan this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/alerter-16.png",
      "48": "icons/alerter-48.png",
      "128": "icons/alerter-128.png"
    }
  },
  "icons": {
    "16": "icons/alerter-16.png",
    "48": "icons/alerter-48.png",
    "128": "icons/alerter-128.png"
  }
}
