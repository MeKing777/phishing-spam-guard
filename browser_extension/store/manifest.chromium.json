{
  "manifest_version": 3,
  "name": "Alerter — Phishing & Spam Protection",
  "version": "2.1.4",
  "description": "Checks phishing risks, blocks common ad and pop-up requests, hides recognizable ad slots, and warns about risky sites.",
  "permissions": [
    "activeTab",
    "notifications",
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://raw.githubusercontent.com/Phishing-Database/Phishing.Database/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "basic_ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "popup-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Alerter — scan this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/alerter-16.png",
      "48": "icons/alerter-48.png",
      "128": "icons/alerter-128.png"
    }
  },
  "icons": {
    "16": "icons/alerter-16.png",
    "48": "icons/alerter-48.png",
    "128": "icons/alerter-128.png"
  }
}
